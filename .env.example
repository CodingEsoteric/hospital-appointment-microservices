# Hospital Appointment Microservices
# Example configuration only - no secrets

PATIENT_SERVICE_PORT=8082
AVAILABILITY_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
APPOINTMENT_SERVICE_PORT=8081

PATIENT_DATABASE_URL=jdbc:sqlite:/data/patient-service.db
AVAILABILITY_DATABASE_URL=jdbc:sqlite:/data/availability-service.db
NOTIFICATION_DATABASE_URL=jdbc:sqlite:/data/notification-service.db
APPOINTMENT_DATABASE_URL=jdbc:sqlite:/data/appointment-service.db

PATIENT_SERVICE_URL=http://patient-service:8082
AVAILABILITY_SERVICE_URL=http://availability-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084
NOTIFICATION_SEND_PATH=/api/notifications
